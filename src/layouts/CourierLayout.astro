---
// src/layouts/CourierLayout.astro
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#FF7800" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
  </head>
  <body class="bg-slate-100">
    <header class="sticky top-0 z-20 bg-slate-800 text-white shadow">
      <div class="container mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/kurir" class="flex items-center gap-2 font-bold text-lg">
          <span class="text-orange-500">BJS Express</span>
          <span class="text-slate-400 text-sm font-normal">Kurir</span>
        </a>
        <div class="flex items-center gap-3">
          <button
            id="btn-kurir-logout"
            class="bg-red-600 hover:bg-red-700 text-white text-sm font-semibold px-3 py-1.5 rounded-lg"
          >
            Keluar
          </button>
        </div>
      </div>
    </header>

    <main class="container mx-auto px-4 py-6">
      <slot />
    </main>

    <script>
      const btn = document.getElementById("btn-kurir-logout");
      btn?.addEventListener("click", async () => {
        const { createBrowserClient } = await import("@supabase/ssr");
        const { PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY } = import.meta.env;
        const sb = createBrowserClient(PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY);
        await sb.auth.signOut();
        window.location.href = "/login";
      });
    </script>
  </body>
</html>
