---
// File: /src/pages/blog/index.astro
import MainLayout from '../../layouts/MainLayout.astro';
import { supabaseAdmin } from '../../lib/supabaseServer';
import FeedGrid from '../../components/feed/FeedGrid.jsx';

export const prerender = false;

const posts = await supabaseAdmin
  .from('feed_posts')
  .select('*, products(id, nama, harga_jual, image_url), feed_comments(count)')
  .eq('is_published', true)
  .order('published_at', { ascending: false })
  .limit(20);

const featured = posts.data?.filter(p => p.is_featured) || [];
const regular = posts.data?.filter(p => !p.is_featured) || [];
---

<MainLayout title="Blog & Tips - BJS Racing Store">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="text-center mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-2">Tips, Info & Cerita BJS Racing</h1>
      <p class="text-slate-500 max-w-2xl mx-auto">Tutorial spray paint, panduan onderdil, review produk, dan cerita di balik custom motor Anda.</p>
    </div>

    {featured.length > 0 && (
      <div class="mb-10">
        <h2 class="text-xl font-bold text-slate-800 mb-4 flex items-center gap-2">
          <span class="w-2 h-6 bg-orange-500 rounded-full"></span>
          Unggulan
        </h2>
        <FeedGrid posts={featured} />
      </div>
    )}

    <div>
      <h2 class="text-xl font-bold text-slate-800 mb-4 flex items-center gap-2">
        <span class="w-2 h-6 bg-orange-500 rounded-full"></span>
        Terbaru
      </h2>
      <FeedGrid posts={regular} />
    </div>
  </div>

  <script type="application/ld+json" slot="head-scripts">
    {
      "@context": "https://schema.org",
      "@type": "Blog",
      "name": "BJS Racing Blog",
      "description": "Tips, info, dan cerita seputar spray paint dan onderdil motor",
      "url": "https://bjsracing.com/blog",
      "publisher": {
        "@type": "Organization",
        "name": "BJS Racing Store",
        "logo": {
          "@type": "ImageObject",
          "url": "https://bjsracing.com/favicon.svg"
        }
      }
    }
  </script>
</MainLayout>
