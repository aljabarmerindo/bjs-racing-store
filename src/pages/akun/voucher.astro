---
// File: /src/pages/akun/voucher.astro
import AccountLayout from '@/layouts/AccountLayout.astro';
import MyVouchersView from '@/components/MyVouchersView.jsx';

const { session } = Astro.locals;
if (!session) {
  return Astro.redirect('/login?redirect=/akun/voucher');
}
---
<AccountLayout title="Voucher Saya - BJS Racing Store" currentPage={Astro.url.pathname}>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <h1 class="text-2xl font-bold text-slate-900">Voucher Saya</h1>
  </div>
  <MyVouchersView client:load />
</AccountLayout>