---
// File: /src/pages/akun/profil.astro
import AccountLayout from '@/layouts/AccountLayout.astro';
import ProfileView from '@/components/ProfileView.jsx';

// Proteksi halaman
const { session } = Astro.locals;
if (!session) {
  return Astro.redirect('/login?redirect=/akun/profil');
}
---
<AccountLayout title="Profil Saya - BJS Racing Store" currentPage={Astro.url.pathname}>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <h1 class="text-2xl font-bold text-slate-900">Profil Saya</h1>
  </div>
  <ProfileView client:load />
</AccountLayout>