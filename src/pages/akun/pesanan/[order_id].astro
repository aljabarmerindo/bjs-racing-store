---
// File: /src/pages/akun/pesanan/[order_id].astro
import MainLayout from '@/layouts/MainLayout.astro';
import { supabaseAdmin } from '@/lib/supabaseServer.ts';
import { formatToWIB } from '@/lib/utils.ts';

const { session } = Astro.locals;
const { order_id } = Astro.params;
const statusParam = Astro.url.searchParams.get('status');

if (!session) {
  return Astro.redirect('/login');
}

let customer = null;
let order = null;

try {
  const { data: customerData, error: customerError } = await supabaseAdmin
    .from('customers')
    .select('id')
    .eq('auth_user_id', session.user.id)
    .single();

  if (customerError || !customerData) {
    return Astro.redirect('/404');
  }
  customer = customerData;

  const { data: orderData, error: orderError } = await supabaseAdmin
    .from('orders')
    .select(`
      *,
      order_items (
        *,
        products (
          nama,
          image_url
        )
      )
    `)
    .eq('id', order_id)
    .eq('customer_id', customer.id)
    .single();

  if (orderError || !orderData) {
    return Astro.redirect('/404');
  }
  order = orderData;
} catch (error) {
  console.error('Order detail fetch error:', error);
  return new Response('Terjadi kesalahan saat memuat data pesanan.', { status: 500 });
}

const formatRupiah = (number: number) => new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", minimumFractionDigits: 0 }).format(number || 0);

let statusMessage = { title: "Status Pesanan Tidak Diketahui", description: "Silakan hubungi customer service kami.", color: "bg-gray-100 text-gray-800" };
const orderStatus = order.status;
const successStatuses = ['paid', 'processing', 'shipped', 'completed'];

if (statusParam === 'success' || successStatuses.includes(orderStatus)) {
  statusMessage = { title: "Pembayaran Berhasil!", description: "Terima kasih atas pesanan Anda. Kami akan segera memprosesnya.", color: "bg-green-100 text-green-800" };
}
if (orderStatus === 'shipped') {
  statusMessage.title = "Pesanan Dikirim";
  statusMessage.description = `Pesanan Anda sedang dalam perjalanan.`;
}
if (orderStatus === 'completed') {
  statusMessage.title = "Pesanan Selesai";
  statusMessage.description = `Pesanan Anda telah sampai tujuan. Terima kasih telah berbelanja!`;
}
if (statusParam === 'pending' || orderStatus === 'awaiting_payment') {
  statusMessage = { title: "Menunggu Pembayaran", description: "Pesanan Anda telah kami terima. Silakan selesaikan pembayaran Anda.", color: "bg-yellow-100 text-yellow-800" };
}
if (orderStatus === 'cancelled') {
  statusMessage = { title: "Pesanan Dibatalkan", description: "Pesanan ini telah dibatalkan.", color: "bg-red-100 text-red-800" };
}

const hasShipping = order.shipping_address && typeof order.shipping_address === 'object';
const hasCourier = order.courier_details && typeof order.courier_details === 'object';
const hasCoordinates = hasShipping && Number.isFinite(order.shipping_address.latitude) && Number.isFinite(order.shipping_address.longitude);
---

<MainLayout title={`Detail Pesanan ${order.order_number}`}>
  <div class="max-w-4xl mx-auto py-8">
    <div class:list={["p-6 rounded-xl mb-8", statusMessage.color]}>
      <h2 class="text-2xl font-bold">{statusMessage.title}</h2>
      <p class="mt-2">{statusMessage.description}</p>
    </div>

    <div class="bg-white p-6 sm:p-8 rounded-xl shadow-md">
      <div class="flex flex-col sm:flex-row justify-between sm:items-center border-b pb-6 mb-6">
        <div>
          <h1 class="text-2xl font-bold">Detail Pesanan</h1>
          <p class="text-slate-500">Nomor Pesanan: <span class="font-medium text-slate-700">{order.order_number}</span></p>
          <p class="text-slate-500">Tanggal: <span class="font-medium text-slate-700">{formatToWIB(order.created_at)}</span></p>
        </div>
        <div class="text-left sm:text-right mt-4 sm:mt-0">
          <span class="text-slate-500">Total Pembayaran</span>
          <p class="text-3xl font-bold text-orange-600">{formatRupiah(order.total_amount)}</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <h3 class="font-bold text-lg mb-4">Dikirim Ke:</h3>
          <div class="text-slate-600 space-y-1">
            {hasShipping ? (
              <>
                <p class="font-semibold">{order.shipping_address.recipient_name || '-'}</p>
                <p>{order.shipping_address.recipient_phone || '-'}</p>
                <p>{order.shipping_address.full_address || '-'}</p>
                <p>{order.shipping_address.destination_text || '-'}</p>
              </>
            ) : (
              <p class="text-slate-400">Alamat tidak tersedia</p>
            )}
          </div>
          <h3 class="font-bold text-lg mt-6 mb-4">Metode Pengiriman:</h3>
          <div class="text-slate-600 space-y-1">
            {hasCourier ? (
              <>
                <p class="font-semibold">{order.courier_details.name || '-'} - {order.courier_details.service || '-'}</p>
                <p>Estimasi Tiba: {order.courier_details.etd || '-'}</p>
              </>
            ) : (
              <p class="text-slate-400">Metode pengiriman tidak tersedia</p>
            )}
            {order.shipping_receipt_number && hasCourier && (
              <div class="mt-2">
                <p>
                  No. Resi: <span class="font-bold text-slate-800">{order.shipping_receipt_number}</span>
                </p>
                <a
                  href={`/lacak-pesanan?awb=${order.shipping_receipt_number}&courier=${order.courier_details.code}`}
                  target="_blank"
                  class="inline-block mt-2 px-4 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700"
                >
                  Lacak Pengiriman
                </a>
              </div>
            )}
          </div>

          {hasCoordinates && (
            <div class="mt-6">
              <h3 class="font-bold text-lg mb-2">Rute Pengiriman</h3>
              <div id="map-placeholder" data-lat={order.shipping_address.latitude} data-lng={order.shipping_address.longitude} data-address={order.shipping_address.destination_text || order.shipping_address.full_address} class="h-[420px] w-full rounded-lg border border-slate-200 bg-slate-100 flex items-center justify-center text-slate-500">
                Peta akan dimuat di sini
              </div>
            </div>
          )}
        </div>
        <div>
          <h3 class="font-bold text-lg mb-4">Ringkasan Item:</h3>
          <div class="space-y-4">
            {(order.order_items || []).map((item: any) => (
              <div class="flex items-center gap-4">
                <div class="w-16 h-16 bg-slate-100 rounded-md flex-shrink-0">
                  {item.products && item.products.image_url ? (
                    <img src={item.products.image_url} alt={item.products.nama || 'Produk'} class="w-full h-full object-contain" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-slate-400 text-xs">No Img</div>
                  )}
                </div>
                <div class="flex-grow">
                  <p class="font-semibold text-slate-800">{item.products?.nama || 'Produk tidak tersedia'}</p>
                  <p class="text-sm text-slate-500">{item.quantity} x {formatRupiah(item.price)}</p>
                </div>
                <div class="font-semibold text-slate-800">
                  {formatRupiah((item.quantity || 0) * (item.price || 0))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="text-center mt-12 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href={`/api/orders/${order.id}/invoice`} target="_blank" class="bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 px-6 rounded-lg transition-colors">
          Unduh Invoice
        </a>
        <a href="/akun/pesanan" class="bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold py-3 px-6 rounded-lg transition-colors">
          Lihat Riwayat Pesanan
        </a>
      </div>
    </div>
  </div>
</MainLayout>
