---
// File: /src/pages/akun/pesanan/[order_id].astro
import MainLayout from '@/layouts/MainLayout.astro';
import { supabaseAdmin } from '@/lib/supabaseServer.ts';
import { formatToWIB } from '@/lib/utils.ts';
import ShippingLabel from '@/components/ShippingLabel.tsx';

const { session } = Astro.locals;
const { order_id } = Astro.params;
const statusParam = Astro.url.searchParams.get('status');

if (!session) {
  return Astro.redirect('/login');
}

let customer = null;
let order = null;

try {
  const { data: customerData, error: customerError } = await supabaseAdmin
    .from('customers')
    .select('id')
    .eq('auth_user_id', session.user.id)
    .single();

  if (customerError || !customerData) {
    return Astro.redirect('/404');
  }
  customer = customerData;

  const { data: orderData, error: orderError } = await supabaseAdmin
    .from('orders')
    .select(`
      *,
      order_items (
        *,
        products (
          nama,
          image_url
        )
      )
    `)
    .eq('id', order_id)
    .eq('customer_id', customer.id)
    .single();

  if (orderError || !orderData) {
    return Astro.redirect('/404');
  }
  order = orderData;
} catch (error) {
  console.error('Order detail fetch error:', error);
  return new Response('Terjadi kesalahan saat memuat data pesanan.', { status: 500 });
}

const formatRupiah = (number: number) => new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", minimumFractionDigits: 0 }).format(number || 0);

let statusMessage = { title: "Status Pesanan Tidak Diketahui", description: "Silakan hubungi customer service kami.", color: "bg-gray-100 text-gray-800" };
const orderStatus = order.status;
const successStatuses = ['paid', 'processing', 'shipped', 'completed'];

if (statusParam === 'success' || successStatuses.includes(orderStatus)) {
  statusMessage = { title: "Pembayaran Berhasil!", description: "Terima kasih atas pesanan Anda. Kami akan segera memprosesnya.", color: "bg-green-100 text-green-800" };
}
if (orderStatus === 'shipped') {
  statusMessage.title = "Pesanan Dikirim";
  statusMessage.description = `Pesanan Anda sedang dalam perjalanan.`;
}
if (orderStatus === 'completed') {
  statusMessage.title = "Pesanan Selesai";
  statusMessage.description = `Pesanan Anda telah sampai tujuan. Terima kasih telah berbelanja!`;
}
if (statusParam === 'pending' || orderStatus === 'awaiting_payment') {
  statusMessage = { title: "Menunggu Pembayaran", description: "Pesanan Anda telah kami terima. Silakan selesaikan pembayaran Anda.", color: "bg-yellow-100 text-yellow-800" };
}
if (orderStatus === 'cancelled') {
  statusMessage = { title: "Pesanan Dibatalkan", description: "Pesanan ini telah dibatalkan.", color: "bg-red-100 text-red-800" };
}

const hasShipping = order.shipping_address && typeof order.shipping_address === 'object';
const hasCourier = order.courier_details && typeof order.courier_details === 'object';
const hasCoordinates = hasShipping && Number.isFinite(order.shipping_address.latitude) && Number.isFinite(order.shipping_address.longitude);
---

<MainLayout title={`Detail Pesanan ${order.order_number}`}>
  <div class="max-w-4xl mx-auto py-8">
    <div class:list={["p-6 rounded-xl mb-8", statusMessage.color]}>
      <h2 class="text-2xl font-bold">{statusMessage.title}</h2>
      <p class="mt-2">{statusMessage.description}</p>
    </div>

    <div class="bg-white p-6 sm:p-8 rounded-xl shadow-md">
      <div class="flex flex-col sm:flex-row justify-between sm:items-center border-b pb-6 mb-6">
        <div>
          <h1 class="text-2xl font-bold">Detail Pesanan</h1>
          <p class="text-slate-500">Nomor Pesanan: <span class="font-medium text-slate-700">{order.order_number}</span></p>
          <p class="text-slate-500">Tanggal: <span class="font-medium text-slate-700">{formatToWIB(order.created_at)}</span></p>
        </div>
        <div class="text-left sm:text-right mt-4 sm:mt-0">
          <span class="text-slate-500">Total Pembayaran</span>
          <p class="text-3xl font-bold text-orange-600">{formatRupiah(order.total_amount)}</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <h3 class="font-bold text-lg mb-4">Ringkasan Pembayaran:</h3>
          <div class="bg-slate-50 rounded-lg p-4 space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-slate-600">Subtotal Produk</span>
              <span class="font-semibold text-slate-800">{formatRupiah((order.order_items || []).reduce((sum: number, item: any) => sum + ((item.quantity || 0) * (item.price || 0)), 0))}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-600">Ongkos Kirim</span>
              <span class="font-semibold text-slate-800">{formatRupiah(order.shipping_cost || 0)}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-600">Fee Transaksi</span>
              <span class="font-semibold text-slate-800">{formatRupiah(order.payment_gateway_fee || 0)}</span>
            </div>
            {(order.discount_amount || 0) > 0 && (
              <div class="flex justify-between">
                <span class="text-slate-600">Diskon</span>
                <span class="font-semibold text-green-600">-{formatRupiah(order.discount_amount || 0)}</span>
              </div>
            )}
            <div class="border-t border-slate-200 pt-2 flex justify-between">
              <span class="font-bold text-slate-800">Total Pembayaran</span>
              <span class="font-bold text-orange-600">{formatRupiah(order.total_amount || 0)}</span>
            </div>
          </div>

          <h3 class="font-bold text-lg mb-4">Dikirim Ke:</h3>
          <div class="text-slate-600 space-y-1">
            {hasShipping ? (
              <>
                <p class="font-semibold">{order.shipping_address.recipient_name || '-'}</p>
                <p>{order.shipping_address.recipient_phone || '-'}</p>
                <p>{order.shipping_address.full_address || '-'}</p>
                <p>{order.shipping_address.destination_text || '-'}</p>
              </>
            ) : (
              <p class="text-slate-400">Alamat tidak tersedia</p>
            )}
          </div>
          <h3 class="font-bold text-lg mt-6 mb-4">Metode Pengiriman:</h3>
          <div class="text-slate-600 space-y-1">
            {hasCourier ? (
              <>
                <p class="font-semibold">{order.courier_details.name || '-'} - {order.courier_details.service || '-'}</p>
                <p>Estimasi Tiba: {order.courier_details.etd || '-'}</p>
              </>
            ) : (
              <p class="text-slate-400">Metode pengiriman tidak tersedia</p>
            )}
            {order.shipping_receipt_number && hasCourier && (
              <div class="mt-2">
                <p>
                  No. Resi: <span class="font-bold text-slate-800">{order.shipping_receipt_number}</span>
                </p>
                <a
                  href={`/lacak-pesanan?awb=${order.shipping_receipt_number}&courier=${order.courier_details.code}`}
                  target="_blank"
                  class="inline-block mt-2 px-4 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700"
                >
                  Lacak Pengiriman
                </a>
              </div>
            )}

            {hasCourier && (
              <div class="mt-6">
                <h3 class="font-bold text-lg mb-2">Shipping Label</h3>
                <ShippingLabel
                  courierCode={order.courier_details.code || order.courier_details.courier_company || ''}
                  courierName={order.courier_details.name || order.courier_details.courier_company || 'Biteship'}
                  routingCode={order.courier_details.routing_code || '-'}
                  waybillId={order.courier_details.waybill_id || order.courier_details.tracking_id || order.shipping_receipt_number || '-'}
                  shippingCost={order.shipping_cost || 0}
                  serviceName={order.courier_details.service || order.courier_details.courier_service_name || '-'}
                  referenceId={order.order_number || '-'}
                  quantity={(order.order_items || []).length}
                  weight={(order.order_items || []).reduce((sum: number, item: any) => sum + ((item.products?.berat_gram || 500) * (item.quantity || 1)), 0)}
                  recipientName={order.shipping_address.recipient_name || '-'}
                  recipientPhone={order.shipping_address.recipient_phone || '-'}
                  recipientAddress={order.shipping_address.full_address || '-'}
                  recipientCity={order.shipping_address.destination_text || '-'}
                  recipientPostal={order.shipping_address.postal_code || '-'}
                  senderName={import.meta.env.BITESHIP_ORIGIN_NAME || 'BJS Racing Store'}
                  senderPhone={import.meta.env.BITESHIP_ORIGIN_PHONE || '-'}
                  senderAddress={import.meta.env.BITESHIP_ORIGIN_ADDRESS || '-'}
                  senderCity="Jepara, Jawa Tengah"
                  senderPostal={import.meta.env.BITESHIP_ORIGIN_POSTAL || '-'}
                  items={(order.order_items || []).map((item: any) => `${item.quantity}x ${item.products?.nama || 'Item'}`).join(', ') || '-'}
                  notes={order.notes || ''}
                  codAmount={order.payment_method === 'cod' ? order.total_amount : 0}
                  insuranceAmount={0}
                />
              </div>
            )}
          </div>

           {hasCoordinates && (
             <div class="mt-6">
               <h3 class="font-bold text-lg mb-2">Rute Pengiriman</h3>
               <div id="map-placeholder" data-lat={order.shipping_address.latitude} data-lng={order.shipping_address.longitude} data-address={order.shipping_address.destination_text || order.shipping_address.full_address} class="h-[420px] w-full rounded-lg border border-slate-200 bg-slate-100 flex items-center justify-center text-slate-500">
                 Peta akan dimuat di sini
               </div>
             </div>
           )}

           {hasCourier && order.courier_details.tracking_id && (
             <div class="mt-6">
               <h3 class="font-bold text-lg mb-2">Lacak Pengiriman</h3>
                <div
                  id="tracking-container"
                  data-tracking-id={order.courier_details.tracking_id || ''}
                  data-shipping-status={order.courier_details.shipping_status || ''}
                  data-courier-code={order.courier_details.code || ''}
                  class="space-y-4"
                >
                 <div id="tracking-card" class="bg-white rounded-xl border border-slate-200 shadow-sm p-5 sm:p-6">
                   <div class="flex items-center gap-4">
                     <div class="w-12 h-12 rounded-xl bg-slate-100 animate-pulse shrink-0"></div>
                     <div class="flex-1 space-y-2">
                       <div class="h-3 w-24 bg-slate-100 rounded animate-pulse"></div>
                       <div class="h-5 w-56 max-w-full bg-slate-100 rounded animate-pulse"></div>
                     </div>
                   </div>
                   <div class="mt-5 h-4 w-40 bg-slate-100 rounded animate-pulse"></div>
                   <div class="mt-5 h-9 bg-slate-100 rounded-lg animate-pulse"></div>
                 </div>
                 <div id="tracking-stepper"></div>
                 <div id="tracking-timeline"></div>
               </div>
             </div>
           )}
        </div>
        <div>
          <h3 class="font-bold text-lg mb-4">Ringkasan Item:</h3>
          <div class="space-y-4">
            {(order.order_items || []).map((item: any) => (
              <div class="flex items-center gap-4">
                <div class="w-16 h-16 bg-slate-100 rounded-md flex-shrink-0">
                  {item.products && item.products.image_url ? (
                    <img src={item.products.image_url} alt={item.products.nama || 'Produk'} class="w-full h-full object-contain" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-slate-400 text-xs">No Img</div>
                  )}
                </div>
                <div class="flex-grow">
                  <p class="font-semibold text-slate-800">{item.products?.nama || 'Produk tidak tersedia'}</p>
                  <p class="text-sm text-slate-500">{item.quantity} x {formatRupiah(item.price)}</p>
                </div>
                <div class="font-semibold text-slate-800">
                  {formatRupiah((item.quantity || 0) * (item.price || 0))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="text-center mt-12 flex flex-col sm:flex-row items-center justify-center gap-3">
        {orderStatus === 'awaiting_payment' && (
          <a href="/checkout" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition-colors">
            Bayar Sekarang
          </a>
        )}
        <a href={`/api/orders/${order.id}/invoice`} target="_blank" class="bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 px-6 rounded-lg transition-colors">
          Unduh Invoice
        </a>
        <a href="/akun/pesanan" class="bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold py-3 px-6 rounded-lg transition-colors">
          Lihat Riwayat Pesanan
        </a>
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline>
  (function() {
    const container = document.getElementById('tracking-container');
    const trackingId = container?.getAttribute('data-tracking-id') || '';
    const localStatus = container?.getAttribute('data-shipping-status') || '';
    if (!trackingId) return;

    const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const S = (inner, cls = 'w-5 h-5') =>
      `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${cls}">${inner}</svg>`;

    const ICONS = {
      package: S('<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>'),
      packageCheck: S('<path d="m16 16 2 2 4-4"/><path d="M21 10V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l2-1.14"/><path d="M3.29 7 12 12l8.71-5"/><path d="M12 22V12"/>'),
      truck: S('<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>'),
      pin: S('<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>'),
      checkCircle: S('<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>'),
      alert: S('<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>'),
      refresh: S('<polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>', 'w-4 h-4'),
      copy: S('<rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>', 'w-4 h-4'),
      clock: S('<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>', 'w-3.5 h-3.5'),
      check: S('<polyline points="20 6 9 17 4 12"/>', 'w-4 h-4'),
    };

    const STATUS_META = {
      pending: { label: 'Menunggu', dot: 'bg-slate-400', ring: 'ring-slate-100', text: 'text-slate-600', icon: 'clock' },
      confirmed: { label: 'Dikonfirmasi', dot: 'bg-slate-400', ring: 'ring-slate-100', text: 'text-slate-600', icon: 'checkCircle' },
      scheduled: { label: 'Dijadwalkan', dot: 'bg-slate-400', ring: 'ring-slate-100', text: 'text-slate-600', icon: 'clock' },
      allocated: { label: 'Kurir dialokasikan', dot: 'bg-slate-400', ring: 'ring-slate-100', text: 'text-slate-600', icon: 'package' },
      picking_up: { label: 'Kurir menuju lokasi penjemputan', dot: 'bg-orange-500', ring: 'ring-orange-100', text: 'text-orange-600', icon: 'pin' },
      picked: { label: 'Barang diambil kurir', dot: 'bg-blue-500', ring: 'ring-blue-100', text: 'text-blue-600', icon: 'package' },
      in_transit: { label: 'Dalam perjalanan', dot: 'bg-blue-500', ring: 'ring-blue-100', text: 'text-blue-600', icon: 'truck' },
      dropping_off: { label: 'Sedang diantar', dot: 'bg-blue-500', ring: 'ring-blue-100', text: 'text-blue-600', icon: 'truck' },
      delivered: { label: 'Tiba di tujuan', dot: 'bg-emerald-500', ring: 'ring-emerald-100', text: 'text-emerald-600', icon: 'packageCheck' },
      failed: { label: 'Pengiriman gagal', dot: 'bg-red-500', ring: 'ring-red-100', text: 'text-red-600', icon: 'alert' },
      cancelled: { label: 'Dibatalkan', dot: 'bg-red-500', ring: 'ring-red-100', text: 'text-red-600', icon: 'alert' },
      on_hold: { label: 'Ditahan sementara', dot: 'bg-amber-500', ring: 'ring-amber-100', text: 'text-amber-600', icon: 'clock' },
      return_in_transit: { label: 'Dalam perjalanan kembali', dot: 'bg-amber-500', ring: 'ring-amber-100', text: 'text-amber-600', icon: 'truck' },
      returned: { label: 'Dikembalikan ke pengirim', dot: 'bg-amber-500', ring: 'ring-amber-100', text: 'text-amber-600', icon: 'package' },
      rejected: { label: 'Ditolak', dot: 'bg-red-500', ring: 'ring-red-100', text: 'text-red-600', icon: 'alert' },
      disposed: { label: 'Paket dimusnahkan', dot: 'bg-red-500', ring: 'ring-red-100', text: 'text-red-600', icon: 'alert' },
      courier_not_found: { label: 'Kurir tidak ditemukan', dot: 'bg-red-500', ring: 'ring-red-100', text: 'text-red-600', icon: 'alert' },
    };

    const PHASE = ['Konfirmasi', 'Penjemputan', 'Pengiriman', 'Selesai'];
    const PHASE_OF = {
      pending: 0, confirmed: 0, scheduled: 0, allocated: 0,
      picking_up: 1, picked: 1,
      in_transit: 2, dropping_off: 2,
      delivered: 3,
      failed: 1, cancelled: 1,
    };
    const FINAL_STATUSES = ['delivered', 'failed', 'cancelled'];

    const escapeHtml = (s) =>
      String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    const COURIER_NAMES = {
      gojek: 'Gojek',
      jne: 'JNE',
      jnt: 'J&T Express',
      tiki: 'TIKI',
      wahana: 'Wahana Express',
      pos: 'POS Indonesia',
      lion: 'Lion Parcel',
    };

    const NOTE_TRANSLATIONS = [
      [/\bbiteship\b/gi, 'Biteship'],
      [/\b(gojek|jne|jnt|tiki|wahana|pos|lion)\b/gi, (m) => COURIER_NAMES[m.toLowerCase()] || m],
      [/pickup number:\s*/gi, 'Nomor penjemputan: '],
      [/order number:\s*/gi, 'Nomor pesanan: '],
      [/\bdelivery delayed due to (?:bad )?weather\b/i, 'Pengiriman tertunda karena cuaca buruk'],
      [/\bdelivery delayed\b/i, 'Pengiriman tertunda'],
      [/delayed due to (?:bad )?weather/i, 'tertunda karena cuaca buruk'],
      [/\bbecause\b/i, 'karena'],
      [/recipient (?:was|is) not available/i, 'penerima tidak ada di tempat'],
      [/rescheduled(?: for (?:the )?next day)?/i, 'dijadwalkan ulang'],
      [/address (?:is )?not complete|incomplete address/i, 'alamat tidak lengkap'],
      [/attempted (?:to )?deliver/i, 'pernah mencoba mengantar'],
      [/failed to (?:deliver|pick up)/i, 'Pengiriman gagal'],
      [/\bcanceled|cancelled\b/i, 'Dibatalkan'],
    ];

    // Teks kanonik per status Biteship (berlaku untuk semua kurir karena status key distandarisasi).
    const STATUS_NOTE_ID = {
      confirmed: 'Pesanan telah dikonfirmasi. Mencari kurir terdekat untuk menjemput paket.',
      scheduled: 'Pesanan telah dijadwalkan untuk pengiriman.',
      allocated: 'Kurir telah dialokasikan dan siap menjemput paket.',
      picking_up: 'Kurir sedang menuju lokasi penjemputan.',
      picked: 'Paket telah diambil oleh kurir.',
      in_transit: 'Paket sedang dalam perjalanan menuju tujuan.',
      dropping_off: 'Kurir sedang mengantar paket ke tujuan.',
      delivered: 'Pesanan telah tiba di tujuan.',
      failed: 'Pengiriman gagal.',
      cancelled: 'Pesanan telah dibatalkan.',
      on_hold: 'Paket sedang ditahan sementara karena suatu alasan.',
      return_in_transit: 'Paket sedang dalam perjalanan kembali ke pengirim.',
      returned: 'Paket telah dikembalikan ke pengirim.',
      rejected: 'Pesanan telah ditolak.',
      disposed: 'Paket telah dimusnahkan/dibuang.',
      courier_not_found: 'Tidak dapat menemukan kurir untuk pesanan ini.',
    };

    // Penanda kalimat Inggris standar Biteship untuk deteksi note yang perlu diganti kanonik.
    const ENGLISH_MARKER = /\b(courier|item|package|order|driver|destination|pick ?up|deliver|transit|allocat|confirm|notified|shipped)\b/i;

    // Pola template standar per status — hanya note yang cocok dengan pola ini yang diganti kanonik.
    // Catatan khusus kurir (mis. "Delivery Delayed Due to Weather") tidak cocok, jadi tetap dipertahankan.
    const STATUS_NOTE_PATTERN = {
      confirmed: /(order|shipment|awb).{0,50}confirm|confirm.{0,50}(order|shipment)/i,
      scheduled: /scheduled/i,
      allocated: /allocated/i,
      picking_up: /(?:pick ?up|on the way)/i,
      picked: /\bpicked\b/i,
      in_transit: /in transit|on the way to (?:the )?destination/i,
      dropping_off: /dropping|out for delivery|on the way to customer/i,
      delivered: /\bdelivered\b/i,
      failed: /fail/i,
      cancelled: /cancel/i,
      on_hold: /hold/i,
      return_in_transit: /return/i,
      returned: /returned/i,
      rejected: /reject/i,
      disposed: /dispos/i,
      courier_not_found: /courier not found|not found/i,
    };

    const translateNote = (note, statusKey) => {
      if (!note) return '';
      let t = String(note);
      const pickup = (t.match(/pickup number:\s*([A-Za-z0-9-]+)/i) || [])[1] || '';
      for (const [re, rep] of NOTE_TRANSLATIONS) t = t.replace(re, rep);
      const key = String(statusKey || '').toLowerCase();
      const pattern = STATUS_NOTE_PATTERN[key];
      if (pattern && pattern.test(t) && ENGLISH_MARKER.test(t) && STATUS_NOTE_ID[key]) {
        t = STATUS_NOTE_ID[key];
        if (pickup) t += ' Nomor penjemputan: ' + pickup;
      }
      t = t.charAt(0).toUpperCase() + t.slice(1);
      return t;
    };

    const formatDateTime = (ts) => {
      const d = new Date(ts);
      if (isNaN(d.getTime())) return '';
      return d.toLocaleString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) + ' WIB';
    };

    function renderHeader(statusKey) {
      const el = document.getElementById('tracking-card');
      if (!el) return;
      const meta = STATUS_META[String(statusKey || '').toLowerCase()] || STATUS_META.pending;
      el.className = 'bg-white rounded-xl border border-slate-200 shadow-sm p-5 sm:p-6 animate-fade-in-up';
      el.innerHTML = `
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div class="flex items-center gap-3.5">
            <span class="w-12 h-12 rounded-xl text-white flex items-center justify-center shrink-0 ${meta.dot}">${ICONS[meta.icon]}</span>
            <div>
              <p class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Status Pengiriman</p>
              <p class="text-base sm:text-lg font-bold leading-snug ${meta.text}">${meta.label}</p>
            </div>
          </div>
          <button id="refresh-tracking" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-900 text-white text-sm font-semibold hover:bg-slate-700 active:scale-95 disabled:opacity-60 transition-colors duration-200 cursor-pointer">
            <span class="refresh-icon inline-flex">${ICONS.refresh}</span>
            Refresh Status
          </button>
        </div>
        <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between gap-3 flex-wrap">
          <div class="flex items-center gap-2 text-sm">
            <span class="font-medium text-slate-500">No. Resi:</span>
            <span class="font-mono font-semibold text-slate-800">${trackingId}</span>
            <button id="copy-resi" title="Salin nomor resi" class="p-1.5 rounded-md text-slate-400 hover:text-slate-700 hover:bg-slate-100 active:scale-95 transition-colors duration-200 cursor-pointer">${ICONS.copy}</button>
          </div>
          <p id="last-updated" class="text-xs text-slate-400 inline-flex items-center gap-1">${ICONS.clock}<span>Pembaruan terakhir: ${new Date().toLocaleString('id-ID', { hour: '2-digit', minute: '2-digit' })} WIB</span></p>
        </div>`;
      wireActions();
    }

    function renderStepper(statusKey) {
      const el = document.getElementById('tracking-stepper');
      if (!el) return;
      const key = String(statusKey || '').toLowerCase();
      const current = PHASE_OF[key] ?? 0;
      const isTerminal = key === 'failed' || key === 'cancelled';
      const steps = PHASE.map((label, i) => {
        const done = i < current;
        const active = i === current;
        const nodeCls = done ? 'bg-emerald-500' : active ? (isTerminal ? 'bg-red-500' : 'bg-orange-500') : 'bg-slate-200 text-slate-500';
        const ring = active && !isTerminal ? 'ring-4 ring-orange-100' : '';
        const pulse = active && !isTerminal && !isReducedMotion ? 'animate-pulse' : '';
        const nodeIcon = done ? ICONS.check : active ? (isTerminal ? ICONS.alert : ICONS.pin) : `<span class="text-sm font-bold">${i + 1}</span>`;
        const labelCls = done ? 'text-emerald-600' : active ? 'text-slate-900' : 'text-slate-400';
        return `
          <div class="flex flex-col items-center gap-1.5 w-16 sm:w-24 shrink-0">
            <span class="w-8 h-8 rounded-full text-white flex items-center justify-center ${nodeCls} ${ring} ${pulse}">${nodeIcon}</span>
            <span class="text-[10px] sm:text-xs font-semibold text-center leading-tight ${labelCls}">${label}</span>
          </div>`;
      }).join('<div class="h-0.5 flex-1 mx-1 sm:mx-2 mt-4 min-w-4"></div>');
      el.className = 'bg-white rounded-xl border border-slate-200 shadow-sm px-4 py-4 sm:px-6 sm:py-5 animate-fade-in-up';
      el.innerHTML = `<div class="flex items-start">${steps}</div>`;
    }

    function renderTimeline(history) {
      const el = document.getElementById('tracking-timeline');
      if (!el) return;
      const merged = Array.isArray(history) ? [...history] : [];
      if (localStatus) {
        const lastKey = merged.length ? String(merged[merged.length - 1].status || '').toLowerCase() : '';
        if (lastKey !== localStatus.toLowerCase()) {
          merged.push({ status: localStatus, note: 'Update status pengiriman', timestamp: '', location: '' });
        }
      }
      if (merged.length === 0) {
        el.className = 'bg-white rounded-xl border border-slate-200 shadow-sm p-10 text-center animate-fade-in-up';
        el.innerHTML = `
          <div class="mx-auto w-14 h-14 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 mb-3">${ICONS.package}</div>
          <p class="font-semibold text-slate-700">Belum ada riwayat pengiriman</p>
          <p class="text-sm text-slate-400 mt-1">Riwayat akan muncul setelah kurir memproses pesanan Anda.</p>`;
        return;
      }
      const items = [...merged].reverse().map((h, i) => {
        const meta = STATUS_META[String(h.status || '').toLowerCase()] || STATUS_META.pending;
        const isLatest = i === 0;
        const isLast = i === merged.length - 1;
        const pulse = isLatest && !isReducedMotion ? 'animate-pulse' : '';
        const time = h.timestamp ? formatDateTime(h.timestamp) : '';
        return `
          <li class="relative pl-14 pb-8 last:pb-0">
            ${isLast ? '' : '<span class="absolute left-[19px] top-10 bottom-0 w-0.5 bg-slate-200"></span>'}
            <span class="absolute left-0 top-0 w-10 h-10 rounded-full text-white flex items-center justify-center ${meta.dot} ${isLatest ? 'ring-4 ring-offset-2 ' + meta.ring : ''} ${pulse}">${ICONS[meta.icon]}</span>
            <p class="font-bold ${meta.text}">${meta.label}</p>
            ${h.note ? `<p class="text-sm text-slate-600 mt-1">${escapeHtml(translateNote(h.note, h.status))}</p>` : ''}
            <p class="text-xs text-slate-400 mt-1.5 flex items-center gap-1.5 flex-wrap">
              ${time ? `<span class="inline-flex items-center gap-1">${ICONS.clock}${time}</span>` : ''}
              ${time && h.location ? '<span class="text-slate-300">•</span>' : ''}
              ${h.location ? `<span class="inline-flex items-center gap-1">${ICONS.pin}${escapeHtml(h.location)}</span>` : ''}
            </p>
          </li>`;
      }).join('');
      el.className = 'bg-white rounded-xl border border-slate-200 shadow-sm p-5 sm:p-6 animate-fade-in-up';
      el.innerHTML = `<h4 class="font-bold text-slate-800 mb-5">Riwayat Pengiriman</h4><ul>${items}</ul>`;
    }

    function renderError(message) {
      const el = document.getElementById('tracking-card');
      if (!el) return;
      el.className = 'bg-white rounded-xl border border-red-200 shadow-sm p-5 animate-fade-in-up';
      el.innerHTML = `
        <div class="flex items-center gap-3 text-red-600">
          <span class="w-10 h-10 rounded-full bg-red-50 flex items-center justify-center shrink-0">${ICONS.alert}</span>
          <div>
            <p class="font-semibold text-sm">Gagal memuat tracking</p>
            <p class="text-xs text-red-500 mt-0.5">${escapeHtml(message)}</p>
          </div>
        </div>`;
    }

    let autoTimer = null;
    function scheduleAutoRefresh(statusKey) {
      clearInterval(autoTimer);
      if (!FINAL_STATUSES.includes(String(statusKey || '').toLowerCase())) {
        autoTimer = setInterval(loadTracking, 60000);
      }
    }

    function copyResi() {
      navigator.clipboard.writeText(trackingId).then(() => {
        const btn = document.getElementById('copy-resi');
        if (!btn) return;
        btn.innerHTML = '<span class="text-xs font-semibold text-emerald-600">Disalin!</span>';
        setTimeout(() => { btn.innerHTML = ICONS.copy; }, 1600);
      }).catch(() => {});
    }

    function wireActions() {
      const refreshBtn = document.getElementById('refresh-tracking');
      if (refreshBtn && !refreshBtn.dataset.wired) {
        refreshBtn.dataset.wired = '1';
        refreshBtn.addEventListener('click', loadTracking);
      }
      const copyBtn = document.getElementById('copy-resi');
      if (copyBtn && !copyBtn.dataset.wired) {
        copyBtn.dataset.wired = '1';
        copyBtn.addEventListener('click', copyResi);
      }
    }

    async function loadTracking() {
      const refreshBtn = document.getElementById('refresh-tracking');
      const refreshIcon = refreshBtn?.querySelector('.refresh-icon');
      if (refreshBtn) refreshBtn.disabled = true;
      if (refreshIcon) refreshIcon.classList.add('animate-spin');

      try {
        const res = await fetch(`/api/shipping/biteship/track?trackingId=${encodeURIComponent(trackingId)}`);
        if (!res.ok) throw new Error('Gagal memuat tracking');
        const data = await res.json();
        const status = data.status || localStatus;
        renderHeader(status);
        renderStepper(status);
        renderTimeline(Array.isArray(data.history) ? data.history : []);
        scheduleAutoRefresh(status);
      } catch (err) {
        if (localStatus) {
          renderHeader(localStatus);
          renderStepper(localStatus);
          renderTimeline([]);
          scheduleAutoRefresh(localStatus);
        } else {
          renderError(err instanceof Error ? err.message : 'Terjadi kesalahan.');
        }
      } finally {
        if (refreshBtn) refreshBtn.disabled = false;
        if (refreshIcon) refreshIcon.classList.remove('animate-spin');
      }
    }

    loadTracking();
  })();
</script>
