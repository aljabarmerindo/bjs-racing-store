---
// File: /src/pages/akun/alamat.astro
import AccountLayout from '@/layouts/AccountLayout.astro';
import AddressSection from '@/components/AddressSection.tsx';

// Proteksi halaman
const { session } = Astro.locals;
if (!session) {
  return Astro.redirect('/login?redirect=/akun/alamat');
}
---
<AccountLayout title="Buku Alamat - BJS Racing Store" currentPage={Astro.url.pathname}>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <h1 class="text-2xl font-bold text-slate-900">Buku Alamat</h1>
  </div>
  <AddressSection client:load />
</AccountLayout>