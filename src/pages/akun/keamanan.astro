---
// File: /src/pages/akun/keamanan.astro
import AccountLayout from '@/layouts/AccountLayout.astro';
import ChangePasswordView from '@/components/ChangePasswordView.jsx';

const { session } = Astro.locals;
if (!session) {
  return Astro.redirect('/login?redirect=/akun/keamanan');
}
---
<AccountLayout title="Keamanan Akun - BJS Racing Store" currentPage={Astro.url.pathname}>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <h1 class="text-2xl font-bold text-slate-900">Ubah Password</h1>
  </div>
  <ChangePasswordView client:load />
</AccountLayout>