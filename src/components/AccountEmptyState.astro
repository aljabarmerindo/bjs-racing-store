---
// File: src/components/AccountEmptyState.astro
const { title, description, primaryAction, secondaryAction } = Astro.props;
---

<div class="col-span-full flex flex-col items-center justify-center py-12 px-4">
  <div class="w-20 h-20 rounded-full bg-slate-50 flex items-center justify-center mb-4 text-slate-400">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 13V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7"/>
      <path d="M20 13h-2a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h2"/>
      <path d="M4 13v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"/>
      <circle cx="12" cy="13" r="2"/>
    </svg>
  </div>
  <h3 class="text-xl font-bold text-slate-900 mb-2">{title}</h3>
  {description && <p class="text-slate-500 text-center max-w-md mb-6">{description}</p>}
  <div class="flex flex-col sm:flex-row gap-3">
    {primaryAction && (
      <a href={primaryAction.href} class="inline-flex items-center justify-center gap-2 bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-2.5 rounded-lg transition-colors">
        {primaryAction.label}
      </a>
    )}
    {secondaryAction && (
      <a href={secondaryAction.href} class="inline-flex items-center justify-center gap-2 bg-white border border-slate-200 text-slate-700 font-semibold px-6 py-2.5 rounded-lg hover:bg-slate-50 transition-colors">
        {secondaryAction.label}
      </a>
    )}
  </div>
</div>
