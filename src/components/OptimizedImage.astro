---
import { optimizeImageUrl } from "@/lib/optimizeImageUrl.ts";
const { src, alt, width = 600, ...props } = Astro.props;
const optimizedSrc = optimizeImageUrl(src, width);
---

{
src ? (
  <img src={optimizedSrc} alt={alt} loading="lazy" decoding="async" {...props} />
) : (
  <div class={props.class?.replace("object-contain", "").replace("object-cover", "").trim() || "w-full h-full bg-slate-100"} />
)
}
